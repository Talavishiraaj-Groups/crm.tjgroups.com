# Local development — points the React app at the LOCAL backend.
#
# Copy this to `.env.local` (which is git-ignored via the *.local rule) and run:
#
#   Terminal 1:  npm run dev:api     # real .gs backend on :8787, in-memory DB
#   Terminal 2:  npm run dev         # Vite on :5173
#
# Nothing here touches production Google Apps Script, Google Sheets or Zoho.
VITE_API_URL=http://localhost:8787
